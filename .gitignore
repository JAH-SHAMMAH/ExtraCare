# ── Dependencies / build artifacts (these are Windows junctions to C:\dev-cache) ──
node_modules/
**/node_modules/
.next/
**/.next/
out/
dist/
build/
*.tsbuildinfo

# ── Python ───────────────────────────────────────────────────────────────────
venv/
**/venv/
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ── Databases / data (do not commit real or dev data) ────────────────────────
*.db
*.db-journal
*.sqlite
*.sqlite3
*.pre-phase2-backup
# Database dumps. A dump carries EVERY user row and password hash, so it must
# never be committable from anywhere in the tree -- the `backups/` rules below
# only cover those two directories.
*.dump
*.dump.*
*.sql
*.sql.gz
*.pgdump
# `*.sql` added deliberately: a hand-made `backup.sql` or `dump.sql` carries the
# same user rows and password hashes as a .dump and was committable. ZERO .sql
# files are tracked in this repo (checked), so nothing is lost -- alembic
# migrations are .py. Force-add with `git add -f` if a real .sql fixture is ever
# needed, and say why in the commit.
backend/extracare.db*
backups/
backend/backups/
backend/uploads/
uploads/

# ── Secrets / environment ────────────────────────────────────────────────────
.env
.env.*
*.env
!.env.example
!.env.production.example
# `.env` and `.env.*` miss a file whose name ENDS in .env -- `prod.env`,
# `backend/staging.env`. Verified: all four spellings are ignored now, and the
# two tracked examples are still re-included above.
*.pem
*.key
*.pfx
*.p12
*.ppk
id_rsa
id_ed25519
certs/

# Credential dumps produced by the scripts in backend/scripts/.
#
# `student_credentials_output.csv` -- 450 rows of (student_id, email,
# temp_password) -- was committed on 2026-08-23 and sat in a PUBLIC repository
# for seven weeks. These rules are deliberately broad and anchored nowhere, so a
# file like it cannot be committed from any directory in the tree.
*credential*.csv
*credentials*.json
*_passwords.csv
*password*.csv
*_logins.csv
*temp_password*
*creds*.csv
*creds*.json
*secrets*.csv
*.key.txt
# "creds" is the spelling a hurried person reaches for, and it matched none of
# the rules above.

# ── Logs / temp ──────────────────────────────────────────────────────────────
*.log
dev-error.log
.DS_Store
Thumbs.db

# ── Editor / OS ──────────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/extensions.json
